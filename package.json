{
  "name": "nextjs-szumplate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze": "next experimental-analyze",
    "biome:check": "biome check .",
    "biome:ci": "biome ci --reporter=github",
    "biome:fix": "biome check --write .",
    "biome:format": "biome format .",
    "biome:format:fix": "biome format --write .",
    "biome:lint": "biome lint .",
    "biome:lint:fix": "biome lint --write .",
    "build": "next build",
    "dev": "next dev",
    "knip": "knip",
    "knip:ci": "knip --reporter github-actions",
    "lint:oxlint": "oxlint .",
    "lint:oxlint:ci": "oxlint . -f sarif > oxlint-results.sarif",
    "lint:oxlint:fix": "oxlint . --fix",
    "start": "next start",
    "storybook:build": "storybook build",
    "storybook:dev": "storybook dev -p 6006",
    "storybook:serve": "serve storybook-static",
    "test": "vitest run --passWithNoTests",
    "test:ci": "vitest --coverage",
    "test:coverage": "vitest --coverage --passWithNoTests",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:e2e:ci": " playwright test --pass-with-no-tests",
    "test:e2e:ui": "playwright test --ui --pass-with-no-tests",
    "test:storybook": "vitest --project=storybook --coverage --passWithNoTests",
    "test:storybook:coverage": "vitest run --project=storybook --coverage.enabled --coverage.reportsDirectory=coverage-storybook",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run --project=unit --passWithNoTests",
    "test:unit:coverage": "vitest run --project=unit --coverage.enabled --coverage.reportsDirectory=coverage-unit",
    "test:watch": "vitest watch --passWithNoTests",
    "type-check": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@loglayer/transport-log-file-rotation": "^3.3.0",
    "@loglayer/transport-pino": "^3.3.0",
    "@szum-tech/design-system": "^3.21.9",
    "@t3-oss/env-nextjs": "^0.13.8",
    "@tailwindcss/postcss": "^4.3.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "loglayer": "^9.4.0",
    "lucide-react": "^1.16.0",
    "next": "^16.3.0",
    "next-themes": "^0.4.6",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "serialize-error": "^13.0.2",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.15",
    "@chromatic-com/storybook": "^5.4.0",
    "@playwright/test": "^1.64.0",
    "@storybook-community/storybook-dark-mode": "^7.1.4",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/nextjs-vite": "^10.6.1",
    "@szum-tech/oxlint-config": "github:JanSzewczyk/oxlint-config#feature/detection-overrides-and-tests",
    "@szum-tech/semantic-release-config": "^2.3.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "knip": "^6.41.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "playwright": "^1.64.0",
    "semantic-release": "^25.0.9",
    "serve": "^14.2.5",
    "storybook": "^10.6.1",
    "storybook-addon-tag-badges": "^3.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
